{
  "name": "BANA 690A Governed ML Pipeline",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "pip install -r requirements.txt && echo 'Setup complete. Run: python -m pytest -q tests/'",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
